{
  "name": "agents-md",
  "version": "0.1.0",
  "private": true,
  "description": "自动读取仓库根目录的 AGENTS.md 作为项目工作指南，在 Agent 执行仓库任务前注入模型上下文。",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "deploy": "pnpm typecheck && pnpm build && node ../../scripts/deploy.mjs",
    "release": "pnpm typecheck && pnpm build && node ../../scripts/release.mjs",
    "release:gh": "node ../../scripts/gh-release.mjs",
    "watch": "node build.mjs --watch"
  },
  "devDependencies": {
    "@obsidian-components/ai-api": "link:../../vendor/ai-api",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ai-plugin-kit": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3"
  }
}