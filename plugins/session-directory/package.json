{
  "name": "session-directory",
  "version": "0.1.0",
  "private": true,
  "description": "在对话窗口侧边提供会话内目录（TOC）：悬浮预览各轮次用户输入内容，点击快速滚动跳转到对应轮次。",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "deploy": "pnpm typecheck && pnpm build && node ../../scripts/deploy.mjs",
    "release": "pnpm typecheck && pnpm build && node ../../scripts/release.mjs",
    "release:gh": "node ../../scripts/gh-release.mjs",
    "watch": "node build.mjs --watch"
  },
  "devDependencies": {
    "@obsidian-components/ai-api": "link:../../vendor/ai-api",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ai-plugin-kit": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3"
  }
}