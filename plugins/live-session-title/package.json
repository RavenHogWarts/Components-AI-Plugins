{
  "name": "live-session-title",
  "version": "0.1.0",
  "private": true,
  "description": "根据对话最新内容持续更新会话标题；支持按会话 ID、标题正则、Agent 名单排除，可配置标题模型与提示词。",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "deploy": "pnpm typecheck && pnpm build && node ../../scripts/deploy.mjs",
    "watch": "node build.mjs --watch"
  },
  "devDependencies": {
    "@obsidian-components/ai-api": "link:../../vendor/ai-api",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
