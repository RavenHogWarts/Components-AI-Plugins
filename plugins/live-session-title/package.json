{
  "name": "live-session-title",
  "version": "0.2.1",
  "private": true,
  "description": "根据对话最新内容持续更新会话标题；支持按会话 ID、标题正则、Agent 名单排除，可配置标题模型与提示词。",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "deploy": "pnpm typecheck && pnpm build && node ../../scripts/deploy.mjs",
    "release": "pnpm typecheck && pnpm build && node ../../scripts/release.mjs",
    "release:gh": "node ../../scripts/gh-release.mjs",
    "watch": "node build.mjs --watch"
  },
  "devDependencies": {
    "@obsidian-components/ai-api": "link:../../vendor/ai-api",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ai-plugin-kit": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3"
  }
}